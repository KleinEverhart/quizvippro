# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=               # secret/service_role key - CHỈ dùng ở server
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # publishable/anon key - an toàn cho trình duyệt

# Tài khoản quản trị (không đưa vào mã nguồn)
ADMIN_USERNAME=admin
ADMIN_MSSV=26119015

# Khóa ký phiên đăng nhập, tối thiểu 32 ký tự (tạo bằng: openssl rand -hex 32)
SESSION_SECRET=
